# ==============================================================================
# SaaS de Transporte Escolar — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.local e preencha os valores reais.
# NENHUM segredo deve ser commitado no código.
# ==============================================================================

# --- Supabase (Postgres, Auth, Realtime, RLS) ---
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Autenticação de Serviço (Contrato com o Agente /api/tools/*) ---
AGENT_SERVICE_TOKEN="change-me-strong-service-token-min-32-chars"

# --- Provedores (Modos: "local" para determinístico/testes | "cloud" para APIs reais) ---
ROUTE_PROVIDER_MODE="local"       # "local" | "google"
PAYMENT_PROVIDER_MODE="local"     # "local" | "asaas"
MESSAGING_PROVIDER_MODE="local"   # "local" | "meta"

# --- Google Maps Platform (Routes API v2 + Maps JS) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-browser-key"
GOOGLE_ROUTES_API_KEY="your-google-routes-server-key"

# --- Pagamentos Pix via Asaas (API v3) ---
ASAAS_API_BASE_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY="your-asaas-api-key"
ASAAS_WEBHOOK_TOKEN="your-asaas-webhook-access-token"

# --- WhatsApp via Meta Cloud API ---
META_GRAPH_API_VERSION="v21.0"
META_WHATSAPP_PHONE_NUMBER_ID="your-meta-phone-number-id"
META_WHATSAPP_ACCESS_TOKEN="your-meta-permanent-access-token"
META_WHATSAPP_VERIFY_TOKEN="your-meta-webhook-verify-token"
META_WHATSAPP_APP_SECRET="your-meta-app-secret-for-hmac-sha256"

# --- URL Base da Aplicação ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
